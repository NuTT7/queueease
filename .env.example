# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/queueease

# Secret used to sign admin session cookies (at least 32 characters).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-32chars

# Shop settings
SHOP_NAME="Barber Nut"
SHOP_TIMEZONE=Asia/Bangkok
SLOT_STEP_MINUTES=15
BOOKING_WINDOW_DAYS=14
MIN_LEAD_MINUTES=60
CANCEL_CUTOFF_MINUTES=120

# Initial admin account created by `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# Optional: POST a JSON message here on every new/cancelled booking
# (e.g. a Discord or Slack incoming-webhook URL). Logged to console if empty.
NOTIFY_WEBHOOK_URL=
